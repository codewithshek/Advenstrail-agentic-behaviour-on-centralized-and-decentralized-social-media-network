# ---- Secrets / env -------------------------------------------------------
.env
.env.*
!.env.example
*.pem
kaggle.json

# ---- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# ---- Jupyter -------------------------------------------------------------
.ipynb_checkpoints/
# Keep notebooks in git, but strip outputs before committing:
#   pip install nbstripout && nbstripout --install

# ---- Data: never commit corpora. Keep the folder skeleton only. ----------
data/**
!data/**/.gitkeep
!data/README.md
!data/manifest.example.json

# ---- datasets/ : the manual drop-zone. Docs are tracked, corpora are not.
#      Several of these are covered by data-use agreements that forbid
#      redistribution (TwiBot-22/24, allenai gated sets) — keep them out of git.
datasets/**
!datasets/README.md
!datasets/*/README.md
!datasets/**/.gitkeep

# ---- Model artefacts (hundreds of MB) ------------------------------------
models/**
!models/**/.gitkeep
!models/README.md
*.pt
*.bin
*.safetensors
*.onnx
*.joblib
*.pkl

# ---- Reports -------------------------------------------------------------
reports/figures/**
!reports/figures/.gitkeep

# ---- Databases -----------------------------------------------------------
*.db
*.sqlite
*.sqlite3

# ---- Node / frontend -----------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# ---- Editors / OS --------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# ---- Logs / caches -------------------------------------------------------
logs/
*.log
wandb/
mlruns/
lightning_logs/
