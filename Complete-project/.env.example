# ============================================================================
#  AEGIS-SN — environment template.  Copy to `.env` and fill in.
#      cp .env.example .env
#  `.env` is git-ignored. NEVER commit real credentials.
#  Loaded automatically by ml/src/aegis/config.py. For FastAPI, either export
#  the values in PowerShell or launch uvicorn with `--env-file .env`.
# ============================================================================

# ---------------------------------------------------------------------------
# Hugging Face — needed for gated/large dataset pulls (HC3, M4, WildGuard).
# Create a READ token at https://huggingface.co/settings/tokens
# Some 2024/2025 safety datasets (allenai/wildguardmix, allenai/wildjailbreak)
# are gated: you must click "Agree and access" on the dataset page FIRST.
# ---------------------------------------------------------------------------
HF_TOKEN=
HF_HOME=./data/external/hf_cache
HF_HUB_ENABLE_HF_TRANSFER=0

# ---------------------------------------------------------------------------
# Kaggle — needed for the TweepFake and Cresci-2017 mirrors.
# Either place kaggle.json at ~/.kaggle/kaggle.json, or set these two.
# ---------------------------------------------------------------------------
KAGGLE_USERNAME=
KAGGLE_KEY=

# ---------------------------------------------------------------------------
# Synthetic agentic-campaign generator (notebook 01).
#   AEGIS_SYNTH_BACKEND = offline | openai | anthropic
#   'offline' = deterministic template engine, needs no key, fully reproducible.
# ---------------------------------------------------------------------------
AEGIS_SYNTH_BACKEND=offline
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
AEGIS_SYNTH_SEED=1337

# ---------------------------------------------------------------------------
# Reproducibility / compute
# ---------------------------------------------------------------------------
AEGIS_SEED=42
AEGIS_DEVICE=auto              # auto | cpu | cuda | mps
AEGIS_SMOKE_TEST=1             # 1 = capped ingestion/development checks
                               # 0 = required by production model training

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# SQLite is the default. Swap this for PostgreSQL in a production deployment.
DATABASE_URL=sqlite:///./data/aegis_api.db
# DATABASE_URL=postgresql+psycopg://aegis:aegis@localhost:5432/aegis

# Comma-separated origins allowed by the CORS middleware.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The frontend is static HTML and defaults to http://127.0.0.1:8000.
# Override it per browser session with:
#   http://127.0.0.1:5173/dashboard.html?api=http://HOST:PORT
